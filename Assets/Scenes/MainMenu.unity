  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "presenta una actividad mental irregular, alternando entre episodios de
    enerjia exesiva y per\xEDodos prolongados de inactividad. Sus vocalizaciones
    espont\xE1neas y sonidos de origen desconocido contin\xFAan siendo objeto de
    estudio. Resulta curioso que pueda dedicar horas a una actividad para luego perder
    todo inter\xE9s en ella."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b4b58ede9d041154c8c007ccaf6de13f, type: 2}
